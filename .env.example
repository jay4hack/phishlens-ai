# PhishLens AI Environment Variables
# Copy this file to .env and configure your secret API key.
# Get your Gemini/Gemma API key at: https://aistudio.google.com/app/apikey

# Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma Model Variant (multimodal capable Gemma 4 or Gemma 3 variant hosted on Google GenAI API)
# Recommended defaults:
# - gemma-4-26b-a4b-it (Multimodal text & image analysis)
# - gemma-4-31b-it
# - gemma-3-27b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
